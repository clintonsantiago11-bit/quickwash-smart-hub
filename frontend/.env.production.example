# ==================================================================
# QuickWash Smart Hub — Frontend (Next.js) PRODUCTION environment
# Set these in the hosting platform BEFORE building. Do NOT commit .env.
# ==================================================================

# Public URL of the Laravel backend, e.g. the Railway generated domain:
#   https://quickwash-backend.up.railway.app/api
# This is inlined into the browser bundle, so it must be the PUBLIC URL.
NEXT_PUBLIC_API_URL=

# Public URL of the Socket.IO bridge for live vendo/NAEK updates.
# Point this at a deployed bridge (or a Cloudflare tunnel to the carwash
# bridge). Leave blank / omit to disable live updates (dashboard still works).
NEXT_PUBLIC_WS_URL=

# LAN URL of the ESP32-CAM control panel. Only reachable while the site is
# served from the same network as the camera; omit on cloud deployments to
# hide the controls.
NEXT_PUBLIC_CAMERA_CONTROL_URL=

# --- Server-side only (NOT exposed to the browser; used by /api/camera/*) ---
CAMERA_HOST=http://192.168.1.7
CAMERA_STREAM_URL=http://192.168.1.7:81/stream