# ==================================================================
# QuickWash Smart Hub — Frontend (Next.js) PRODUCTION environment
# Set these in the hosting platform BEFORE building. Do NOT commit .env.
# ==================================================================

# Public URL of the Laravel backend on Render, including the /api suffix.
# This is inlined into the browser bundle at build time, so it must be the
# PUBLIC URL and it must be set before the build runs - not added afterwards.
NEXT_PUBLIC_API_URL=

# Public URL of the Socket.IO edge bridge for live vendo/NAEK updates.
# Leave blank / omit to disable live updates (the dashboard still works).
NEXT_PUBLIC_WS_URL=

# Direct LAN address of the ESP32-CAM's own web UI. Used only to label the
# camera entry; the in-app viewer goes through the /api/camera proxy instead.
NEXT_PUBLIC_CAMERA_CONTROL_URL=

# Set to any non-empty value when a camera relay IS deployed, so the cameras
# page can say "the bridge is not answering" rather than "this site has no route
# to the camera" - those are different faults and point at different fixes.
#
# The URL is NOT used to build any request. The browser never contacts the relay
# directly; /api/camera/stream does, server-side, using CAMERA_RELAY_URL below.
# That indirection is what keeps the bridge's key out of the browser bundle.
NEXT_PUBLIC_CAMERA_RELAY_URL=

# ------------------------------------------------------------------
# Server-side only. Never prefix these with NEXT_PUBLIC_ - they must not
# reach the browser bundle.
# ------------------------------------------------------------------

# Signs the camera session cookie. Without it the camera proxy refuses every
# request (fail closed) and POST /api/session returns 503.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Any non-empty string works, but a random 32-byte value is the point: this is
# the only thing the camera proxy trusts, because the ESP32-CAM authenticates
# nothing itself. Rotating it invalidates every issued cookie immediately,
# which is the closest thing to a server-side session revoke this design has.
CAMERA_SESSION_SECRET=

# Lifetime of that cookie, in minutes. Defaults to 480, matching the backend's
# SANCTUM_TOKEN_EXPIRATION. Keep the two in step: the cookie is stateless, so
# revoking the Sanctum token does not revoke the cookie before it expires.
CAMERA_SESSION_TTL_MINUTES=480

# Allow the camera's own write-style controls (/control, /resolution) through
# the panel proxy. Off by default.
#
# /reg, /greg, /xclk and /pll read and WRITE sensor registers and are never
# proxied regardless of this setting - a misconfigured sensor there can leave
# the camera unusable until it is power-cycled. This flag only governs the
# ordinary exposure/resolution controls, which are not needed to watch the bay.
CAMERA_PANEL_ALLOW_WRITE=false

# Where the camera actually is. A LAN address the cloud cannot route to is the
# normal case, and the dashboard will correctly show the camera as offline.
# Point these at a tunnel only if you have put real authentication in front of
# the proxy (see CAMERA_SESSION_SECRET above).
CAMERA_HOST=http://192.168.1.7
CAMERA_STREAM_URL=http://192.168.1.7:81/stream

# --- Camera relay (optional) ---
#
# The camera cannot be reached from the cloud, so the stream comes back through
# the iot-bridge agent running on the wash-bay PC, exposed by a tunnel. Set
# CAMERA_RELAY_URL to that tunnel's base URL.
#
# The bridge requires its own key (BRIDGE_API_KEY). It is sent from this route,
# server-side, and never reaches the browser. Leave both blank for a LAN-only
# setup and the proxy talks to CAMERA_STREAM_URL directly.
CAMERA_RELAY_URL=
CAMERA_RELAY_KEY=