# IoT Bridge environment (copy to .env and adjust)
PORT=3001

# --- MQTT broker ---
# A public broker such as broker.hivemq.com has NO authentication: anyone on
# the internet can subscribe to this facility's topics and read or forge
# telemetry. It also has no replay or retention control, so anyone can publish
# a fake sensor reading or a fake coin drop. Use it for a bench demo only.
#
# For anything real, point at a broker with credentials (HiveMQ Cloud or EMQX
# both have free tiers) and fill in the two variables below - they are passed to
# the MQTT connect as username/password when BOTH are set.
#
# NB the legacy advice in older revisions was to embed credentials in the URL
# (mqtts://user:pass@host:8883). That still works but puts the password in
# process arguments, so prefer the separate fields.
MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=quickwash/quickwash_main

# --- Low-supply thresholds ---
#
# NOT configured here. These live in the database (system_settings, id=1) and
# are edited on the dashboard at /settings. This agent loads them at start and
# re-reads them every 60s, so a change applies without a restart.
# The defaults if the table has no row yet: water 20%, soap 15%, wax 15%.

FACILITY_ID=quickwash_main

# Shared secret for the bridge's own endpoints. Must match NAEK_INGEST_KEY on
# the Laravel API. The API refuses to accept ingest if its key is blank, so
# the two must be set together.
#
# This also gates /camera/stream and /camera/status. Once this agent is exposed
# through a tunnel that is the ONLY credential in front of the ESP32-CAM, which
# authenticates nothing itself. It must be set whenever the agent is reachable
# from outside the LAN, and it is sent as the x-api-key header - never as a
# query parameter, which would leak it into access logs.
#
# On the dashboard side, give this value to CAMERA_RELAY_KEY. The frontend
# proxy sends it from the server; the browser never sees it.
BRIDGE_API_KEY=

# Comma-separated browser origins allowed to call the bridge (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Camera relay (ESP32-CAM is on the wash-bay LAN) ---
# The deployed site cannot reach a LAN address, so this agent relays the
# stream. Expose this agent publicly (Cloudflare Tunnel, ngrok, or a port
# forward) and set the URL on Vercel to use it.
CAMERA_HOST=http://192.168.1.7
CAMERA_STREAM_PATH=/stream

# --- NAEK edge agent ---
# Set false to disable polling entirely
NAEK_ENABLED=true
# Where the NAEK dashboard lives (default while joined to its hotspot)
NAEK_HOST=http://192.168.4.1
# Device row ID + display name in the QuickWash devices table
NAEK_DEVICE_ID=naek_carwash_1
NAEK_DEVICE_NAME=NAEK 3-in-1 Carwash Timer
# Poll interval in ms (min 5000)
NAEK_POLL_MS=15000
# Where data goes.
#   'db'  -> the MySQL on THIS machine. Nothing reaches the cloud, so the
#            dashboard, analytics and vending pages stay empty.
#   'api' -> POST to the Laravel API, which is what a deployed install needs.
# Pick 'api' unless you are deliberately running a local-only demo.
NAEK_SINK=api

# Only used when NAEK_SINK=api. Point it at the DEPLOYED API, not localhost:
# this agent runs on the carwash PC, which cannot reach a Render/Vercel URL
# by accident and vice versa.
NAEK_API_URL=https://quickwash-api.onrender.com/api

# Must match NAEK_INGEST_KEY on the API host. The API refuses to accept
# ingest if its own key is blank, so the two have to be set together.
NAEK_API_KEY=

# --- Database (used by db.js in 'db' sink mode) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=quickwash_hub
DB_PORT=3306
