# IoT Bridge environment (copy to .env and adjust)
PORT=3001

# --- MQTT broker ---
# A public broker such as broker.hivemq.com has NO authentication: anyone on
# the internet can subscribe to this facility's topics and read or forge
# telemetry. Run a private broker with credentials for anything beyond a
# bench demo, e.g. mqtts://<user>:<pass>@<your-broker>:8883
MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=quickwash/quickwash_main

FACILITY_ID=quickwash_main

# Shared secret for the bridge's own endpoints. Must match NAEK_INGEST_KEY on
# the Laravel API. The API refuses to accept ingest if its key is blank, so
# the two must be set together.
BRIDGE_API_KEY=

# Comma-separated browser origins allowed to call the bridge (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- NAEK edge agent ---
# Set false to disable polling entirely
NAEK_ENABLED=true
# Where the NAEK dashboard lives (default while joined to its hotspot)
NAEK_HOST=http://192.168.4.1
# Device row ID + display name in the QuickWash devices table
NAEK_DEVICE_ID=naek_carwash_1
NAEK_DEVICE_NAME=NAEK 3-in-1 Carwash Timer
# Poll interval in ms (min 5000)
NAEK_POLL_MS=15000
# Where data goes: 'db' = local MySQL | 'api' = Laravel ingest endpoint (cloud)
NAEK_SINK=db
# Only used when NAEK_SINK=api
NAEK_API_URL=http://localhost:8000/api
NAEK_API_KEY=

# --- Database (used by db.js in 'db' sink mode) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=quickwash_hub
DB_PORT=3306
