# ==================================================================
# QuickWash Smart Hub — Backend (Laravel) PRODUCTION environment
# Copy the values a hosting platform gives you. Do NOT commit .env.
# ==================================================================

APP_NAME=QuickWashHub
APP_ENV=production
# Set a fixed 32-char base64 key. If left blank the container auto-generates
# one on first boot (see docker/entrypoint.sh). A fixed key avoids invalidating
# sessions on every redeploy.
APP_KEY=
APP_DEBUG=false
# Public URL of THIS backend, e.g. the Railway generated domain:
#   https://quickwash-backend.up.railway.app
APP_URL=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (Railway "MySQL" template wires these automatically) ---
# Created plugin exposes: MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=

# Session/cache stay file-based (single container). Switches to Redis/DB
# if you ever scale past one instance.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# --- CORS / cookies ---
# Must be exactly the URL the dashboard is served from, no trailing slash.
FRONTEND_URL=https://quickwash.up.railway.app
# Trust the platform's reverse proxy so client IPs / HTTPS are detected correctly.
TRUSTED_PROXIES=*

# --- Sanctum ---
# Token lifetime in minutes. 480 = 8h; matches the frontend session cookie TTL.
SANCTUM_TOKEN_EXPIRATION=480

FILESYSTEM_DISK=local

# --- NAEK edge-agent ingest (shared secret with iot-bridge/.env) ---
# Must match iot-bridge NAEK_API_KEY. Generate with: openssl rand -hex 24
NAEK_INGEST_KEY=

# --- First admin account (database seeder) ---
# Set a strong, unique password before the first boot. While it is set it is
# authoritative (re-applied on every boot); remove it after the first login if
# you want in-app password changes to stick.
# Leaving it blank makes the seeder generate one and print it once to the logs.
ADMIN_EMAIL=admin@quickwash.hub
ADMIN_PASSWORD=

# --- MQTT (optional live updates; broker must be reachable from the cloud) ---
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=quickwash_backend
MQTT_TOPIC_PREFIX=quickwash/quickwash_main

# --- Reverb (not used in production yet) ---
REVERB_APP_ID=quickwash-hub
REVERB_APP_KEY=quickwash-reverb-key
REVERB_APP_SECRET=quickwash-reverb-secret
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https