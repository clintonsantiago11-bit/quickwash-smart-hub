# ==================================================================
# QuickWash Smart Hub — Backend (Laravel) PRODUCTION environment
#
# Target stack: Render (this API) + TiDB Cloud (database) + Vercel
# (Next.js dashboard, see frontend/.env.production.example).
#
# Copy these into the Render dashboard as Environment Variables.
# Do NOT commit a filled-in copy of this file.
# ==================================================================

APP_NAME=QuickWashHub
APP_ENV=production
# Must be exactly "production": backend/config/cache.php overrides a file
# cache store with it, which is what keeps the login brute-force lockout
# off the container's ephemeral filesystem.
APP_DEBUG=false
# This backend's own public URL on Render, e.g. https://quickwash-api.onrender.com
APP_URL=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database: TiDB Cloud Starter / Essential ---
#
# TiDB renamed the "Serverless" tier to Starter / Essential. The MySQL wire
# protocol is the same, but the details that matter here are:
#   * Port is 4000, not 3306.
#   * The public endpoint REQUIRES TLS; an unencrypted connection is refused.
#   * The server certificate is issued by Let's Encrypt (ISRG Root X1).
DB_CONNECTION=mysql
# Host looks like <region>.prod.aws.tidbcloud.com — from the Connect dialog.
DB_HOST=
DB_PORT=4000
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# TLS. backend/config/database.php already defaults DB_SSL_CA to this path and
# the Dockerfile installs ca-certificates, so ISRG Root X1 is trusted without
# setting this. Set it only to override.
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# TiDB Cloud fronts a stateless gateway that severs idle connections. Laravel's
# persistent PDO connections do not retry, so a pooled connection can be
# handed back dead. Non-persistent reconnects per request instead.
# (This inverts the historical default in config/database.php, which was tuned
# to cut TiDB round trips and is why the escape hatch exists.)
DB_PERSISTENT=false

# --- Cache / session / queue ---
#
# CACHE_DRIVER=database is not optional in production: the sign-in lockout
# (AuthController) and every route throttle live in the cache. On Render the
# filesystem is ephemeral, so a file store resets those counters on every
# deploy and every spin-down. The cache/cache_locks tables are created by
# migration 0001_01_01_000001.
CACHE_DRIVER=database
# Session auth is unused (the dashboard authenticates with a Sanctum bearer
# token), so this only needs to not crash.
SESSION_DRIVER=file
BROADCAST_DRIVER=log
QUEUE_CONNECTION=sync

# --- CORS ---
#
# FRONTEND_URL must be exactly the Vercel origin, no trailing slash, no
# trailing newline.
FRONTEND_URL=
# Comma-separated extras: a custom domain, a second frontend, a staging host.
FRONTEND_URLS=
# Lets Vercel preview deployments reach the API by origin pattern. Safe
# because auth is the Authorization header, not a cookie. Set to false for a
# strict allowlist.
ALLOW_VERCEL_PREVIEWS=true

# --- Reverse proxy ---
# Render terminates TLS in front of the container. Without this the app sees
# the proxy as the client IP and http:// everywhere, which breaks $request->ip()
# in the audit trail and the login lockout key.
TRUSTED_PROXIES=*

# --- Sanctum ---
# Token lifetime in minutes. 480 = 8h, matches the dashboard's session cookie.
SANCTUM_TOKEN_EXPIRATION=480
# Leave unset. The dashboard is on Vercel and authenticates with a bearer
# token, so Sanctum's cookie fallback is not used. Setting this to the Vercel
# origin would turn on stateful cookie auth, which is a different design.
# SANCTUM_STATEFUL_DOMAINS=localhost:3000

FILESYSTEM_DISK=local

# --- NAEK edge-agent ingest ---
# Shared secret with NAEK_API_KEY in iot-bridge/.env. This key writes sale
# telemetry straight into the revenue tables, so generate a fresh one and do
# not reuse the local development value.
# Generate with: openssl rand -hex 24
NAEK_INGEST_KEY=

# --- First admin account (database seeder) ---
#
# ADMIN_PASSWORD set  -> applied on every boot, overwriting any in-app change.
# ADMIN_PASSWORD unset -> the existing admin is left alone; a brand-new install
#                          gets a random password printed once in the logs.
# Remove it after the first sign-in to let in-app password changes stick.
ADMIN_EMAIL=admin@quickwash.hub
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator

# --- MQTT (optional live updates; broker must be reachable from the cloud) ---
# broker.hivemq.com is a PUBLIC broker and its topics are world-readable.
# Replace with an authenticated broker before handling real money.
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=quickwash_backend
MQTT_TOPIC_PREFIX=quickwash/quickwash_main

# --- Reverb (not used in production yet) ---
REVERB_APP_ID=quickwash-hub
REVERB_APP_KEY=quickwash-reverb-key
REVERB_APP_SECRET=quickwash-reverb-secret
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https