APP_NAME=QuickWashHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quickwash_hub
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Allowed CORS origin for browser clients (the Next.js dashboard).
# Keep this in sync with the frontend deployment URL in production.
FRONTEND_URL=http://localhost:3000

SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Token lifetime in minutes (default 8h). Short expiry limits blast radius.
SANCTUM_TOKEN_EXPIRATION=480
SESSION_DOMAIN=localhost

FILESYSTEM_DISK=local

REVERB_APP_ID=quickwash-hub
REVERB_APP_KEY=quickwash-reverb-key
REVERB_APP_SECRET=quickwash-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=quickwash_backend
MQTT_TOPIC_PREFIX=quickwash/quickwash_main

# NAEK edge-agent ingest (shared secret with iot-bridge NAEK_API_KEY)
NAEK_INGEST_KEY=quickwash-bridge-key

# First admin account created by the seeder. Leave the password blank and the
# seeder generates a random one, printing it once (never a hard-coded default).
ADMIN_EMAIL=admin@quickwash.hub
ADMIN_PASSWORD=
